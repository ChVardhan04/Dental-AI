# ---- Application
APP_ENV=production
AUTO_CREATE_TABLES=false            # schema is managed by `alembic upgrade head`
LOG_LEVEL=INFO
# ---- Secrets (REQUIRED in production; startup fails if missing/weak)
JWT_SECRET_KEY=change-me-to-a-64-char-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
# ---- Database / storage
DATABASE_URL=postgresql+psycopg://dentedge:dentedge@db:5432/dentedge
STORAGE_BACKEND=local               # local | s3
UPLOAD_DIR=/data/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
REDIS_URL=redis://redis:6379/0
# ---- Access
CORS_ORIGINS=https://ai.dentedge.example
BOOTSTRAP_ADMIN_EMAIL=admin@dentedge.example
BOOTSTRAP_ADMIN_PASSWORD=
JWT_ACCESS_TOKEN_MINUTES=60
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
DATA_RETENTION_DAYS=3650
# ---- AI providers (no vendor lock-in)
LLM_PROVIDER=template               # template | openai | anthropic | local
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
VISION_PROVIDER=research            # research | llm | none
SPEECH_PROVIDER=none                # none | openai | local
LOCAL_SPEECH_BASE_URL=
# Which registry statuses may run. For a clinical launch use: production
ALLOWED_MODEL_STATUSES=production,staging,research
CONFIDENCE_THRESHOLD=0.60
# ---- Integration
APPOINTMENT_BOOKING_URL=https://www.dentedge.com/book-appointment
